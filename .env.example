# SIMPLEIN SCHOOL ERP — environment template.
# Copy to .env.local and fill values from the Supabase + Vercel dashboards.
# NEVER commit real secrets. See docs/ARCHITECTURE.md §14.

# Public (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (Vercel env / local .env.local — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer token guarding POST /api/v1/onboarding/school.
# Generate with: openssl rand -hex 32
ONBOARDING_SECRET=

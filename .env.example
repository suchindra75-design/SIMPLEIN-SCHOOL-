# SIMPLEIN SCHOOL ERP — environment template (staging integration).
# Copy to .env.local and fill values from the Supabase dashboard.
# NEVER commit real secrets. See docs/STAGING.md and docs/ARCHITECTURE.md §14.
#
# Where values come from (names only — no values live in this repo):
# - Supabase dashboard → staging project → Project Settings → API:
#   Project URL (= NEXT_PUBLIC_SUPABASE_URL) and anon public key
#   (= NEXT_PUBLIC_SUPABASE_ANON_KEY).
# - Same screen, "service_role" key (= SUPABASE_SERVICE_ROLE_KEY, server-only).
# - ONBOARDING_SECRET: generate locally with `openssl rand -hex 32` and store
#   it ONLY in server env (local .env.local + Vercel project settings).

# Public (safe for the browser bundle; RLS still enforced server-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical origin used for links/emails. Recommended; defaults to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (Vercel env / local .env.local — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer token guarding POST /api/v1/onboarding/school.
# Generate with: openssl rand -hex 32
ONBOARDING_SECRET=

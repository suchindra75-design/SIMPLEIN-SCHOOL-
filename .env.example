# SIMPLEIN SCHOOL ERP — environment template (staging integration).
# Copy to .env.local and fill values from the Supabase dashboard.
# NEVER commit real secrets. See docs/STAGING.md and docs/ARCHITECTURE.md §14.
#
# Where values come from (names only — no values live in this repo):
# - Supabase dashboard → project → Project Settings → API Keys:
#   Project URL (= NEXT_PUBLIC_SUPABASE_URL) and a publishable key,
#   sb_publishable_… (= NEXT_PUBLIC_SUPABASE_ANON_KEY).
# - Same screen, a secret key, sb_secret_… (= SUPABASE_SERVICE_ROLE_KEY,
#   server-only). Do not use the legacy anon/service_role JWT keys.
# - ONBOARDING_SECRET: generate locally with `openssl rand -hex 32` and store
#   it ONLY in server env (local .env.local + Vercel project settings).

# Public (safe for the browser bundle; RLS still enforced server-side)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical origin used for links/emails. Recommended; defaults to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (Vercel env / local .env.local — never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer token guarding POST /api/v1/onboarding/school.
# Generate with: openssl rand -hex 32
ONBOARDING_SECRET=

# Optional: local measurement scripts only (scripts/measure_*). Use dedicated
# test accounts, never real users, and keep values in .env.local only.
# Run with: node --env-file=.env.local scripts/<script>
# MEASURE_ADMIN_LOGIN=
# MEASURE_ADMIN_PASSWORD=
# MEASURE_TEACHER_LOGIN=
# MEASURE_TEACHER_PASSWORD=
# MEASURE_PARENT_LOGIN=
# MEASURE_PARENT_PASSWORD=
# MEASURE_STUDENT_LOGIN=
# MEASURE_STUDENT_PASSWORD=
# Required only when measuring protected Preview deployments:
# VERCEL_AUTOMATION_BYPASS_SECRET=
